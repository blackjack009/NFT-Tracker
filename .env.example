# ── REQUIRED ─────────────────────────────────────────────────────────────
# Telegram bot token (from @BotFather) and the chat that receives alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── TRACKED WALLETS ("cluster") ──────────────────────────────────────────
WALLETS_FILE=wallets.json

# ── CHAINS (EVM only, beta) ──────────────────────────────────────────────
# Valid keys: ethereum,base,arbitrum,optimism,bsc,polygon,avalanche,blast,linea,
# scroll,zksync,mantle,zora,opbnb,berachain,unichain
CHAINS_ENABLED=base,ethereum,arbitrum,optimism,bsc,polygon

# Optional per-chain RPC overrides (recommended for reliability/speed):
# RPC_BASE=https://mainnet.base.org

# ── OPTIONAL DATA PROVIDERS ──────────────────────────────────────────────
# Alchemy key (https://alchemy.com) — more stable RPCs for supported chains
ALCHEMY_API_KEY=
# OpenSea API v2 key (https://docs.opensea.io) — better collection metadata
OPENSEA_API_KEY=

# ── TUNING (several of these are editable live via /settings in Telegram) ─
# Polling interval per chain (ms). Lower is faster but consumes rate limits.
POLL_INTERVAL_MS=6000
# Max block range per eth_getLogs request
MAX_BLOCK_RANGE=1500
# Hard cap on mint price per NFT (ETH) — also configurable from /settings
MAX_MINT_PRICE_ETH=0.5
# Review timeout before an alert expires (ms) — default only, editable in /settings
CONFIRM_TIMEOUT_MS=120000
# Bridge fee buffer (fraction of the mint price)
BRIDGE_BUFFER_PCT=0.15
# Maximum bridge price gap versus the sent value (%). Quotes above this are
# rejected. Gap = (received USD value / sent USD value − 1); covers relayer
# fees plus route slippage.
MAX_BRIDGE_GAP_PCT=1.5

# ── WALLET ───────────────────────────────────────────────────────────────
# PRIVATE_KEY is used only ONCE to seed the keystore (data/keystore.json) on
# first start. Afterwards, manage wallets from /start → Wallet
# (Create / Import / Export / Preferred — multi-wallet, EVM + Solana).
PRIVATE_KEY=

# ── OPTIONAL: Alchemy webhooks (instant alerts; requires a public endpoint) ─
# WEBHOOK_PORT=8787
# ALCHEMY_SIGNING_KEY=

# ── INTERNAL ─────────────────────────────────────────────────────────────
RELAY_API_URL=https://api.relay.link
DATA_DIR=data
HEAT_WINDOW_MIN=15
